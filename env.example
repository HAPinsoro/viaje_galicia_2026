# ===================================================================
# Expedición Galicia 10 Días - Environment Variables (.env)
# ===================================================================

# -------------------------------------------------------------------
# 1. Supabase Authentication & Database (VPS / Coolify o Supabase Cloud)
# -------------------------------------------------------------------
# Configura aquí tu endpoint de Supabase (auto-alojado en tu VPS o en supabase.com).
# Proporciona login seguro con asignación de pareja (ByL vs AyM).
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-public-key-aqui"

# -------------------------------------------------------------------
# 2. PostgreSQL Relacional (VPS / Coolify)
# -------------------------------------------------------------------
# Conexión directa a PostgreSQL en tu VPS para persistencia local
DATABASE_URL="postgresql://postgres:galicia2026_secure_pass@localhost:5432/galicia_trip"
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="galicia_trip"
PGUSER="postgres"
PGPASSWORD="galicia2026_secure_pass"

# -------------------------------------------------------------------
# 3. Google Gemini API (Server-side)
# -------------------------------------------------------------------
# Required for the AI Copilot Assistant and apartment/gastronomy search
# with Google Maps Grounding. Get your key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# -------------------------------------------------------------------
# 4. Google Maps Platform (Client-side)
# -------------------------------------------------------------------
# Required for interactive map rendering, driving directions and place search.
# APIs to enable in Google Cloud Console:
# - Maps JavaScript API
# - Directions API
# - Places API (New)
VITE_GOOGLE_MAPS_API_KEY="AIzaSyD2M10m6SheEHKmLtfUcqS604NOyBy3PA4"

# Map ID for Advanced Markers and Vector Map styling
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# -------------------------------------------------------------------
# 5. Firebase / Firestore Configuration (Opcional / Fallback)
# -------------------------------------------------------------------
# By default, reads credentials from `firebase-applet-config.json`
# VITE_FIREBASE_API_KEY="AIzaSyA0B2tF6D4OgVARBAY701myl-AvrCm4Hus"
# VITE_FIREBASE_AUTH_DOMAIN="massive-gamma-5ds98.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="massive-gamma-5ds98"
# VITE_FIREBASE_STORAGE_BUCKET="massive-gamma-5ds98.firebasestorage.app"
# VITE_FIREBASE_DATABASE_ID="ai-studio-rutagalicia10das-511c0ac9-b4df-4089-941a-931b8393db9d"

# -------------------------------------------------------------------
# 6. Server Configuration
# -------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
